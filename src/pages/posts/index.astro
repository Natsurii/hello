---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";

// Pin the order to slug-asc: the legacy manifest listed building-static-sites
// before welcome-to-my-blog, so alphabetical keeps parity.
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { slug: "asc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Legacy manifest dates are GMT+8 calendar days; render that day, not the UTC one.
const iso = (d: Date | null | undefined) =>
	d
		? new Date(d.getTime() + 8 * 3600 * 1000).toISOString().slice(0, 10)
		: "";
---

<Base
	title="Natsurii - Blogs"
	description="Natsurii's Portfolio. Blog List"
	ogType="website"
	ogImage="/assets/og/blogs.png"
>
	<h1 class="sr-only">Natsurii - Blogs</h1>
	<div class="blog-header-banner">C:\BLOGS\INDEX.LOG</div>
	<div id="blog-posts-list">
		{
			posts.map((post) => (
				<div class="blog-post-card">
					<div class="blog-post-date">
						<time datetime={iso(post.data.publishedAt)}>
							[{iso(post.data.publishedAt)}]
						</time>
					</div>
					<h2 class="blog-post-title">
						<a href={`/posts/${post.id}`}>{post.data.title}</a>
					</h2>
					<p class="blog-post-desc">{post.data.excerpt}</p>
					<div class="blog-post-divider" />
				</div>
			))
		}
	</div>

	<script is:inline>
		document.addEventListener("DOMContentLoaded", function () {
			fitAsciiLines();
		});
	</script>
</Base>