---
import { getEmDashEntry, decodeSlug } from "emdash";
import Base from "../../layouts/Base.astro";
import RetroPortableText from "../../components/RetroPortableText.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Image fields are media objects: local ones carry meta.storageKey, external ones src.
const imgUrl = (img: any): string | undefined => {
	if (!img || typeof img !== "object") return undefined;
	if (typeof img.src === "string" && img.src) return img.src;
	if (typeof img.meta?.storageKey === "string")
		return `/_emdash/api/media/file/${img.meta.storageKey}`;
	if (typeof img.url === "string" && img.url) return img.url;
	return undefined;
};

const image = imgUrl(post.data.featured_image);
const published = post.data.publishedAt;
---

<Base
	title={`Natsurii - ${post.data.title}`}
	description={post.data.excerpt ?? ""}
	ogType="article"
	ogImage={image}
	ogUrl={`${Astro.site ?? Astro.url.origin}/posts/${post.id}`}
	publishedTime={published ? published.toISOString() : undefined}
	mainClass="ascii-container markdown-container"
>
	<h1 class="sr-only">{post.data.title}</h1>
	<div class="blog-nav-top">
		<a href="/posts">&lt;-- [back to blogs]</a>
		<hr class="retro-hr" />
	</div>
	<div id="post-content">
		<RetroPortableText value={post.data.content ?? []} />
	</div>
	<div class="blog-nav-bottom">
		<hr class="retro-hr" />
		<a href="/posts">&lt;-- [back to blogs]</a>
	</div>

	<link
		id="prism-dark"
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-okaidia.min.css"
	/>
	<link
		id="prism-light"
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism.min.css"
		disabled
	/>
	<script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js" defer
	></script>

	<script is:inline>
		document.addEventListener("DOMContentLoaded", function () {
			if (window.Prism) Prism.highlightAll();
			fitAsciiLines();
			var imgs = document.querySelectorAll("#post-content img");
			for (var i = 0; i < imgs.length; i++)
				imgs[i].addEventListener("load", fitAsciiLines);
		});
	</script>
</Base>