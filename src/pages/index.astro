---
import Base from "../layouts/Base.astro";
---

<Base
	title="Natsurii - Portfolio"
	description="Natsurii's Portfolio. Front Page"
	ogType="website"
>
	<h1 class="sr-only">Natsurii - Portfolio</h1>
	<div id="main-art" class="ascii-container" aria-hidden="true"></div>

	<script is:inline>
		document.addEventListener("DOMContentLoaded", function () {
			asciiToHTML("/components/index.utf8ans", "#main-art", 20, 100);
		});
	</script>
</Base>