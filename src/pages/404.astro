---
import Base from "../layouts/Base.astro";
---

<Base
	title="Page not found."
	description="Page not found. The page you are looking for does not exist or was moved."
	ogType="website"
	ogTitle="Natsurii - 404"
	ogImage="/assets/og/404.png"
>
	<div class="error-404">
		<h1>Page Not Found</h1>
		<p>The page you are looking for does not exist or was moved.</p>
		<a href="/">&lt;-- [go home]</a>
	</div>
	<div id="main-art" class="ascii-container" aria-hidden="true"></div>

	<script is:inline>
		document.addEventListener("DOMContentLoaded", function () {
			asciiToHTML("/components/404.utf8ans", "#main-art", 20, 100);
		});
	</script>
</Base>