---
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	ogType?: "website" | "article" | "profile";
	ogImage?: string;
	ogUrl?: string;
	ogTitle?: string;
	publishedTime?: string;
	mainClass?: string;
}

const {
	title,
	description,
	ogType = "website",
	ogImage = "",
	ogUrl = "",
	ogTitle,
	publishedTime,
	mainClass = "",
} = Astro.props;

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: ogType,
	title,
	pageTitle: ogTitle ?? title,
	description,
	canonical: ogUrl || undefined,
	seo: { ogImage: ogImage || undefined },
	siteName: "Natsurii",
	articleMeta: { publishedTime, author: ogType === "article" ? "Natsurii" : undefined },
});
---

<!doctype html>
<html lang="en">
	<head>
		<script is:inline>
			(function () {
				try {
					var t =
						localStorage.getItem("natsurii-theme") === "light" ? "light" : "dark";
					document.documentElement.setAttribute("data-theme", t);
				} catch (e) {
					document.documentElement.setAttribute("data-theme", "dark");
				}
			})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<EmDashHead page={pageCtx} />
		{ogType === "profile" && <meta property="og:type" content="profile" />}
		<link rel="preconnect" href="https://cdn.jsdelivr.net" />
		<link
			rel="preload"
			href="/assets/Px437_IBM_VGA_9x16.ttf"
			as="font"
			type="font/ttf"
		/>
		<link rel="icon" type="image/gif" href="/assets/favicon.gif" />
		<script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js" defer></script>
		<script src="/scripts/site.js" defer></script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">Skip to Content</a>
		<nav class="sr-nav" aria-label="Main Navigation">
			<a href="/">Home</a>
			<a href="/about">About</a>
			<a href="/posts">Blogs</a>
		</nav>
		<header class="ascii-container" aria-hidden="true"></header>
		<main id="main" class={mainClass}>
			<slot />
		</main>
		<footer class="ascii-container" aria-hidden="true"></footer>

		<script is:inline>
			document.addEventListener("DOMContentLoaded", function () {
				asciiToHTML("/components/header.utf8ans", "header", 2, 5, function () {
					addHyperlinkToText("header", "<home>", "/");
					addHyperlinkToText("header", "<about>", "/about");
					addHyperlinkToText("header", "<blogs>", "/posts");
				});
				asciiToHTML("/components/footer.utf8ans", "footer", 2, 5);
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>