						"$media": {
							"url": "https://raw.githubusercontent.com/Natsurii/hello/v3/assets/og/building-static-sites.png",
							"filename": "building-static-sites.png",
							"alt": "Why Vanilla JS and Markdown Rock"
						}
					},
					"content": [
						{
							"_type": "block",
							"_key": "b11",
							"style": "h1",
							"children": [
								{
									"_type": "span",
									"_key": "s10",
									"text": "Why Vanilla JS and Markdown Rock"
								}
							]
						},
						{
							"_type": "block",
							"_key": "b13",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s12",
									"text": "In an era of massive component frameworks and complex build pipelines, going back to basics is refreshing."
								}
							]
						},
						{
							"_type": "block",
							"_key": "b15",
							"style": "h2",
							"children": [
								{
									"_type": "span",
									"_key": "s14",
									"text": "The Beauty of Vanilla JS"
								}
							]
						},
						{
							"_type": "block",
							"_key": "b19",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s16",
									"text": "Writing vanilla JavaScript forces you to understand the DOM, asynchronous requests ("
								},
								{
									"_type": "span",
									"_key": "s17",
									"text": "fetch",
									"marks": [
										"code"
									]
								},
								{
									"_type": "span",
									"_key": "s18",
									"text": "), and string manipulation without layers of abstraction."
								}
							]
						},
						{
							"_type": "block",
							"_key": "b1b",
							"style": "h3",
							"children": [
								{
									"_type": "span",
									"_key": "s1a",
									"text": "Advantages"
								}
							]
						},
						{
							"_type": "block",
							"_key": "b1e",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s1c",
									"text": "Blazing Fast",
									"marks": [
										"strong"
									]
								},
								{
									"_type": "span",
									"_key": "s1d",
									"text": ": Loads instantly with zero bloat."
								}
							],
							"listItem": "number",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b1j",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s1f",
									"text": "Easy to Maintain",
									"marks": [
										"strong"
									]
								},
								{
									"_type": "span",
									"_key": "s1g",
									"text": ": No "
								},
								{
									"_type": "span",
									"_key": "s1h",
									"text": "node_modules",
									"marks": [
										"code"
									]
								},
								{
									"_type": "span",
									"_key": "s1i",
									"text": " hell or broken package locks."
								}
							],
							"listItem": "number",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b1m",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s1k",
									"text": "True Ownership",
									"marks": [
										"strong"
									]
								},
								{
									"_type": "span",
									"_key": "s1l",
									"text": ": Every line of code is yours."
								}
							],
							"listItem": "number",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b1o",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s1n",
									"text": "Combine this with Markdown files for content, and you have a resilient, portable blogging platform that can be hosted anywhere for free!"
								}
							]
						}
					]
