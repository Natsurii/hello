								{
									"_type": "span",
									"_key": "s1x",
									"text": "Optimized firmware for 16-bit/32-bit MCUs and DSPs across diverse semiconductor and industrial applications to improve system reliability, delivering cleaner, more stable operation on every device."
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b20",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s1z",
									"text": "Accelerated onboarding and cross-team knowledge transfer by documenting the theory of operation for 3 new technology blocks, giving design teams a clear reference for future work."
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b22",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s21",
									"text": "Diagnosed and resolved 2 complex hardware-firmware integration faults using JTAG and GDB debugging, working closely with the hardware engineering team to isolate root causes across both domains."
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b24",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s23",
									"text": "Enabled earlier hardware validation by developing an internal hardware tool that verifies firmware functions at the signal level, cutting the wait for hardware-level testing by 12 weeks."
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b26",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s25",
									"text": "Streamlined firmware validation by automating functional test strategies with Python scripts, replacing slow manual checks with repeatable, reliable runs."
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "b28",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"_key": "s27",
									"text": "Strengthened release confidence by contributing to CI/CD pipeline improvements for firmware builds and testing, making deployments more consistent and dependable across key projects."
